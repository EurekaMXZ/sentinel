# Local development defaults. Never commit real credentials.
# Compose reads this file with --env-file .env.example, or reads .env automatically.
# The Go application reads process environment variables; it does not load .env.

HTTP_ADDR=127.0.0.1:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=1m
SHUTDOWN_TIMEOUT=10s
GIN_MODE=release

TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_AGENT_TASK_QUEUE=sentinel-agent
TEMPORAL_SOURCE_TASK_QUEUE=sentinel-source
TEMPORAL_RELAY_TASK_QUEUE=sentinel-relay
TEMPORAL_DIAL_TIMEOUT=5s

# POSTGRES_* configures the Compose database on its first initialization.
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel-dev-password
# Keep this DSN consistent with POSTGRES_* when changing local credentials.
POSTGRES_DSN=postgres://sentinel:sentinel-dev-password@127.0.0.1:5432/sentinel?sslmode=disable

# S3_ENDPOINT is host:port, without a URL scheme.
S3_ENDPOINT=127.0.0.1:9000
S3_BUCKET=sentinel
S3_REGION=
# Compose also uses these credentials for the local MinIO root user.
S3_ACCESS_KEY=sentinel-dev
S3_SECRET_KEY=sentinel-dev-secret
S3_USE_TLS=false

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_REQUEST_TIMEOUT=2m

GIT_BINARY=git
# Application source-repository cache; unrelated to Go build/module caches.
SOURCE_CACHE_DIR=var/git
